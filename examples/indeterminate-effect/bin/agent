#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Stand-in for an AI agent's completion report. (A script, not a model.)

It runs the command it was given, and if the command exits 0 it reports the
task as done: the usual "run the command, check the exit code" habit. It writes
its report to --claim and prints it.
"""
import argparse
import json
import pathlib
import subprocess
import sys
import time

parser = argparse.ArgumentParser()
parser.add_argument("--task", required=True)
parser.add_argument("--claim", required=True, type=pathlib.Path)
parser.add_argument("--stdin", required=True, type=pathlib.Path)
parser.add_argument("--stdout", required=True, type=pathlib.Path)
parser.add_argument("command", nargs=argparse.REMAINDER)
args = parser.parse_args()
command = args.command[1:] if args.command[:1] == ["--"] else args.command
done = subprocess.run(command, input=args.stdin.read_bytes(), capture_output=True)
args.stdout.write_bytes(done.stdout)
if done.returncode == 0:
    message = f"Done. {args.task}: completed successfully."
else:
    message = f"{args.task}: the command failed (exit {done.returncode})."
claim = {"schema": "example.agent-claim/v1", "task": args.task, "message": message,
         "basis": f"command exited {done.returncode}", "claimed_at_unix_ms": time.time_ns() // 1_000_000}
args.claim.write_text(json.dumps(claim, indent=2, sort_keys=True) + "\n")
print(message)
sys.exit(done.returncode)
