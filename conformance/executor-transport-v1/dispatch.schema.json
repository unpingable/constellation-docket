{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docket.governed-executor-dispatch/v1",
  "title": "Docket governed-executor dispatch V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempt", "marker", "work_schema", "work", "subject", "scope"],
  "properties": {
    "attempt": {"$ref": "#/$defs/digest"},
    "marker": {"$ref": "#/$defs/digest"},
    "work_schema": {"type": "string", "minLength": 1},
    "work": {"$ref": "#/$defs/digest"},
    "subject": {"$ref": "#/$defs/digest"},
    "scope": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
